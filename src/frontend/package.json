{
  "name": "cupmaster-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "tsc -b --noEmit && VITE_API_URL=https://api.cupmaster.xyz vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "verify:attribution-tag": "node --env-file-if-exists=.env --experimental-strip-types scripts/verify-attribution-tag.ts"
  },
  "dependencies": {
    "@celo/attribution-tags": "^0.3.0",
    "@reown/appkit": "1.6.4",
    "@reown/appkit-adapter-wagmi": "1.6.4",
    "@tanstack/react-query": "^5.100.14",
    "clsx": "^2.1.1",
    "hono": "^4.12.23",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "viem": "2.21.0",
    "wagmi": "2.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.4.11"
  }
}
